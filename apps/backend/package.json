{
  "name": "roll_together_backend",
  "version": "0.2.0",
  "description": "Backend for the Roll Together browser extension",
  "main": "./build/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "start": "npm run build && npm run start:prod",
    "start:dev": "tsx watch src/server.ts",
    "start:prod": "node --enable-source-maps ./build/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuraiexx/roll_together_backend.git"
  },
  "keywords": [
    "Chrome",
    "Extension",
    "Crunchyroll",
    "Party"
  ],
  "author": "SamuraiExx",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/samuraiexx/roll_together_backend/issues"
  },
  "homepage": "https://github.com/samuraiexx/roll_together_backend#readme",
  "dependencies": {
    "@roll-together/protocol": "*",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
