  "version": "0.2.0",
  "description": "Backend for Roll Together Chrome Extension",
  "main": "./build/server.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && npm run start:prod",
    "start:dev": "nodemon --config nodemon.json src/server.ts",
    "start:prod": "node ./build/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w4r6/roll_together.git"
  },
  "keywords": [
