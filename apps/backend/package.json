  "license": "MIT",
  "bugs": {
    "url": "https://github.com/w4r6/roll_together/issues"
  },
  "homepage": "https://github.com/w4r6/roll_together#readme",
  "dependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^22.0.0",
    "express": "^4.17.2",
    "socket.io": "^4.4.1",
    "ts-node": "^10.4.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.4"
  }
}
