{
  "name": "roll_together",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:extension": "npm run build -w roll_together_extension",
    "build:backend": "npm run build -w roll_together_backend",
    "build:chrome": "npm run build:chrome -w roll_together_extension",
    "build:firefox": "npm run build:firefox -w roll_together_extension",
    "build:production": "npm run build:production -w roll_together_extension",
    "build:production:chrome": "npm run build:production:chrome -w roll_together_extension",
    "build:production:firefox": "npm run build:production:firefox -w roll_together_extension",
    "watch:chrome": "npm run watch:chrome -w roll_together_extension",
    "watch:firefox": "npm run watch:firefox -w roll_together_extension",
    "package:extension": "npm run package -w roll_together_extension",
    "package:chrome": "npm run package:chrome -w roll_together_extension",
    "package:firefox": "npm run package:firefox -w roll_together_extension",
    "start:backend": "npm run start -w roll_together_backend",
    "start:backend:prod": "npm run start:prod -w roll_together_backend",
    "start:backend:dev": "npm run start:dev -w roll_together_backend"
  }
}
